# Скопируйте в donatix/.env и заполните. Файл .env не коммитится.

# ── Обязательно ────────────────────────────────────────────
# Длинная случайная строка для подписи сессий. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DONATIX_SECRET_KEY=

# Адрес сайта (используется в документации и примерах)
DONATIX_BASE_URL=https://donatix.gg

# Первый админ создаётся при запуске, если админов ещё нет
DONATIX_ADMIN_EMAIL=you@example.com
DONATIX_ADMIN_PASSWORD=

# ── Поставщик ──────────────────────────────────────────────
# mock — демо-каталог без реальных заказов; fazer — настоящий FazerCards
DONATIX_SUPPLIER=fazer
# Ключ из панели FazerCards → Профиль
FAZER_API_KEY=
FAZER_BASE_URL=https://api.fzr.cards/api/v2
# Скидка вашего тарифа FazerCards на пополнение Steam, % (Bronze 2.5, Silver 3, Gold 3.55)
FAZER_STEAM_DISCOUNT=2.5

# ── Наценка, % поверх закупки ──────────────────────────────
# Ваша прибыль сверху цены FazerCards. Отдельному клиенту можно поставить
# свою наценку (дешевле или дороже) в админке → Клиенты → клиент.
DONATIX_MARKUP_BRONZE=8
DONATIX_MARKUP_SILVER=8
DONATIX_MARKUP_GOLD=8
# Для пополнения Steam своя наценка — маржа там маленькая
DONATIX_MARKUP_STEAM=1.5

# ── Уведомления вам в Telegram (необязательно) ─────────────
# Бот-админка: создайте бота у @BotFather, узнайте свой chat id у @userinfobot.
# Бот присылает заявки на пополнение, новых партнёров и проблемные заказы с кнопками
# (Зачислить / Отклонить / Одобрить / Вернуть деньги), команды: /stats /payments /users /orders.
# Отвечает только в этом чате.
DONATIX_ALERT_TELEGRAM_TOKEN=
DONATIX_ALERT_TELEGRAM_CHAT_ID=
DONATIX_SUPPLIER_LOW_BALANCE=50

# ── Прочее ─────────────────────────────────────────────────
# Контакт поддержки, показывается клиентам (как пополнить баланс)
DONATIX_SUPPORT_CONTACT=@donatix_support
# 1 — новые клиенты ждут одобрения админа (рекомендуется)
DONATIX_REQUIRE_APPROVAL=1
# 1 — куки только по HTTPS (включите на сервере с сертификатом)
DONATIX_COOKIE_SECURE=1
DONATIX_DB=donatix/data/donatix.db
DONATIX_CATALOG_SYNC_MINUTES=60
DONATIX_ORDER_POLL_SECONDS=20

# ── Пополнение баланса клиентами ───────────────────────────
# Реквизиты, которые увидит клиент. Пустой способ не показывается.
# \n в значении — перенос строки.
DONATIX_PAY_ALIF=Алиф: +992 XX XXX XX XX (Имя Фамилия)
DONATIX_PAY_DC=
DONATIX_PAY_ESKHATA=
DONATIX_PAY_KORTI_MILLI=
DONATIX_PAY_USDT_TRC20=
DONATIX_PAY_BINANCE=
# Курс: сколько сомони за 1 доллар (для Алиф, DC, Эсхата, Корти Милли)
DONATIX_TJS_RATE=10.9
DONATIX_PAY_MIN_USD=5

# ── Письма клиентам (необязательно) ────────────────────────
# Например, Gmail: smtp.gmail.com, порт 587, пароль приложения.
DONATIX_SMTP_HOST=
DONATIX_SMTP_PORT=587
DONATIX_SMTP_USER=
DONATIX_SMTP_PASSWORD=
DONATIX_SMTP_FROM=

# Подтверждение сайта для поиска: код из метатега Google Search Console / Яндекс Вебмастера
DONATIX_GOOGLE_VERIFY=
DONATIX_YANDEX_VERIFY=

# Курс USD→TJS автоматически из открытых источников (1 — вкл, 0 — вручную) и запас к нему, %
DONATIX_RATE_AUTO=1
DONATIX_RATE_MARGIN=1

# Вход через Google: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: https://ВАШ-ДОМЕН/auth/google/callback
DONATIX_GOOGLE_CLIENT_ID=
DONATIX_GOOGLE_CLIENT_SECRET=

# Автоплатёж криптой: Binance Pay (кабинет мерчанта → API) и TronGrid (необязательно)
DONATIX_BINANCE_PAY_KEY=
DONATIX_BINANCE_PAY_SECRET=
DONATIX_TRONGRID_KEY=
DONATIX_BYBIT_KEY=
DONATIX_BYBIT_SECRET=
